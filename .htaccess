# .htaccess — tudoemdia.blog.br (Hostinger / Apache / LiteSpeed)
# Gerado por scripts/set-domain.mjs. Não edite o domínio à mão.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + host canônico (www.tudoemdia.blog.br -> tudoemdia.blog.br)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.tudoemdia\.blog\.br$ [NC]
  RewriteRule ^(.*)$ https://tudoemdia.blog.br/$1 [R=301,L]
  # Quem digitar sitemap.xml (ou só "sitemap") cai no índice gerado pelo Astro
  RewriteRule ^sitemap(\.xml)?\.?$ https://tudoemdia.blog.br/sitemap-index.xml [R=301,L]

  # Endereços antigos -> novos (gerado a partir de src/redirects.json)
  RewriteRule ^seguro-auto/perfil-do-condutor-seguro/?$ https://tudoemdia.blog.br/seguro-auto/perfil-do-condutor-seguro-auto/ [R=301,L]
  RewriteRule ^documentacao/como-transferir-carro-usado/?$ https://tudoemdia.blog.br/documentacao-do-veiculo/como-transferir-carro-usado/ [R=301,L]
  RewriteRule ^manutencao/calibragem-pneu-pressao-correta/?$ https://tudoemdia.blog.br/manutencao-do-carro/calibragem-pneu-pressao-correta/ [R=301,L]
  RewriteRule ^documentacao/comunicacao-de-venda-veiculo/?$ https://tudoemdia.blog.br/documentacao-do-veiculo/comunicacao-de-venda-de-veiculo/ [R=301,L]
  RewriteRule ^manutencao/quando-trocar-oleo-do-carro/?$ https://tudoemdia.blog.br/manutencao-do-carro/quando-trocar-oleo-do-carro/ [R=301,L]
  RewriteRule ^documentacao/crlv-digital-como-baixar/?$ https://tudoemdia.blog.br/documentacao-do-veiculo/crlv-digital-como-baixar/ [R=301,L]
  RewriteRule ^manutencao/o-que-e-feito-na-revisao/?$ https://tudoemdia.blog.br/manutencao-do-carro/o-que-e-feito-na-revisao-do-carro/ [R=301,L]
  RewriteRule ^ipva-licenciamento/quem-paga-ipva-venda-carro/?$ https://tudoemdia.blog.br/ipva-licenciamento/quem-paga-ipva-na-venda-do-carro/ [R=301,L]
  RewriteRule ^multas-cnh/como-recorrer-de-multa/?$ https://tudoemdia.blog.br/multas-cnh/como-recorrer-de-multa-de-transito/ [R=301,L]
  RewriteRule ^manutencao/revisao-fora-concessionaria-garantia/?$ https://tudoemdia.blog.br/manutencao-do-carro/revisao-fora-da-concessionaria-perde-garantia/ [R=301,L]
  RewriteRule ^documentacao/atpv-e-o-que-e/?$ https://tudoemdia.blog.br/documentacao-do-veiculo/atpv-e-o-que-e-como-assinar/ [R=301,L]
  RewriteRule ^documentacao/?$ https://tudoemdia.blog.br/documentacao-do-veiculo/ [R=301,L]
  RewriteRule ^manutencao/?$ https://tudoemdia.blog.br/manutencao-do-carro/ [R=301,L]

  # URLs com barra final (padrão do site): /pagina -> /pagina/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://tudoemdia.blog.br/$1/ [R=301,L]

  # Bloqueia arquivos ocultos, exceto .well-known (validação de SSL)
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # /_astro/ (nomes com hash): 1 ano; HTML/XML: sempre revalidar; imagens: 30 dias
  SetEnvIf Request_URI "^/_astro/" ASTRO_ASSET
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=2592000" env=!ASTRO_ASSET
    Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/rss+xml application/json application/javascript image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>
