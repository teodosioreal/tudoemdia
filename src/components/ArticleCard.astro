---
import { Picture } from 'astro:assets';
import { getCategory } from '../config';
import { articleUrl, type Article } from '../lib/content';
export interface Props { article: Article; eager?: boolean; headingLevel?: 'h2' | 'h3' }
const { article, eager = false, headingLevel = 'h3' } = Astro.props;
const { title, description, image, imageAlt, category } = article.data;
const url = articleUrl(article);
const H = headingLevel;
---
<article class="card">
  <Picture
    src={image}
    alt={imageAlt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[360, 600, 800]}
    sizes="(min-width: 1160px) 360px, (min-width: 700px) 45vw, 100vw"
    width={800}
    height={420}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
  <div class="card__body">
    <span class="card__cat">{getCategory(category).name}</span>
    <H class="card__title"><a href={url}>{title}</a></H>
    <p class="card__desc">{description}</p>
  </div>
</article>
