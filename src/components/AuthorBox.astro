---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { initials } from '../lib/content';
export interface Props { slug: string; name: string; jobTitle: string; bio: string; avatar?: ImageMetadata }
const { slug, name, jobTitle, bio, avatar } = Astro.props;
---
<section class="author-box" aria-labelledby="author-box-name">
  {
    avatar ? (
      <Image src={avatar} alt={`Foto de ${name}`} width={64} height={64} densities={[1, 2]} class="avatar avatar--box" loading="lazy" draggable="false" />
    ) : (
      <div class="author-box__avatar" aria-hidden="true">{initials(name)}</div>
    )
  }
  <div>
    <p class="author-box__name" id="author-box-name">
      Escrito por <a href={`/autor/${slug}/`} rel="author">{name}</a>
    </p>
    <p>{jobTitle}</p>
    <p>{bio}</p>
  </div>
</section>
