---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE, ADS } from '../config';
import { abs } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  /** Imagem de capa (otimizada para 1200x630) ou caminho em /public */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Título já completo (sem sufixo do site) — usado na home */
  rawTitle?: boolean;
  jsonLd?: object;
  /** Seção e tags do artigo (article:section / article:tag) */
  section?: string;
  tags?: readonly string[];
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  rawTitle = false,
  jsonLd,
  section,
  tags = [],
} = Astro.props;

// O sufixo com o nome do site só entra se o título completo couber em ~60 caracteres,
// para não ser cortado no resultado do Google.
const withSuffix = `${title} | ${SITE.name}`;
const fullTitle = rawTitle || withSuffix.length > 60 ? title : withSuffix;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

let ogImage = abs(SITE.defaultOgImage);
let ogW = 1200;
let ogH = 630;
if (image && typeof image !== 'string') {
  const img = await getImage({ src: image, width: 1200, height: 630, format: 'webp', fit: 'cover' });
  ogImage = abs(img.src);
} else if (typeof image === 'string') {
  ogImage = abs(image);
}
const ogType = image && typeof image !== 'string' ? 'image/webp' : 'image/png';
---

<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="pt-BR" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
{SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
<link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
<meta name="theme-color" content={SITE.themeColor} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
<link rel="icon" href="/icon-96.png" type="image/png" sizes="96x96" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content={ogType} />
<meta property="og:image:width" content={String(ogW)} />
<meta property="og:image:height" content={String(ogH)} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{section && <meta property="article:section" content={section} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

{
  /* Só carrega o AdSense quando ADS.enabled = true E houver client configurado. */
  ADS.enabled && ADS.client && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`}
      crossorigin="anonymous"
    />
  )
}
