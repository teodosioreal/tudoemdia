---
/**
 * Seção "Perguntas frequentes". Use no MDX como <Faq /> — lê o `faq`
 * do frontmatter (o mesmo que alimenta o JSON-LD FAQPage).
 */
export interface Props { items?: { q: string; a: string }[] }
const items = Astro.props.items ?? [];
---
{
  items.length > 0 && (
    <section class="faq" aria-labelledby="perguntas-frequentes">
      <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  )
}
