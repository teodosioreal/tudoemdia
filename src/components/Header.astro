---
import { SITE, CATEGORIES } from '../config';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
// Destaca "em Dia" na marca quando o nome do site contiver essa expressão
const [before, after] = SITE.name.includes('em Dia') ? SITE.name.split('em Dia') : [SITE.name, null];
const links = [
  ...CATEGORIES.map((c) => ({ href: `/${c.slug}/`, label: c.name, current: path.startsWith(`/${c.slug}/`) })),
  { href: '/sobre/', label: 'Sobre', current: path === '/sobre/' },
  { href: '/contato/', label: 'Contato', current: path === '/contato/' },
  { href: '/busca/', label: 'Buscar', current: path === '/busca/' },
];
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${SITE.name}, página inicial`}>
      <Logo />
      <span>{before}{after !== null && <span class="brand__em">em Dia</span>}{after}</span>
    </a>
    <!-- Desktop: menu sempre visível -->
    <nav class="site-nav site-nav--desktop" aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <!-- Celular: menu recolhível, funciona sem JavaScript -->
    <details class="site-nav site-nav--mobile">
      <summary>☰ Menu</summary>
      <nav aria-label="Principal">
        <ul>
          {links.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
