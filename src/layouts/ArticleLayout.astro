---
import { Picture, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AdSlot from '../components/AdSlot.astro';
import Toc from '../components/Toc.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, ADS, getCategory } from '../config';
import { articleUrl, formatDate, isoDate, type Article } from '../lib/content';
import {
  abs, graph, organization, website, person, breadcrumbList, faqPage, personId, ORG_ID, WEBSITE_ID,
} from '../lib/schema';
import { getImage } from 'astro:assets';

export interface Props {
  wordCount?: number;
  article: Article;
  author: { slug: string; name: string; jobTitle: string; bio: string; sameAs: string[]; avatar?: ImageMetadata };
  headings: MarkdownHeading[];
  related: Article[];
}

const { article, author, headings, related, wordCount } = Astro.props;
const d = article.data;
const cat = getCategory(d.category);
const url = articleUrl(article);
const crumbs = [
  { name: 'Início', href: '/' },
  { name: cat.name, href: `/${cat.slug}/` },
  { name: d.title, href: url },
];
const readMinutes = Math.max(1, Math.round((wordCount ?? 0) / 200));
const shareUrl = abs(url);
const shareText = encodeURIComponent(`${d.title} ${shareUrl}`);
const tocHeadings = d.faq?.length
  ? [...headings, { depth: 2, slug: 'perguntas-frequentes', text: 'Perguntas frequentes' }]
  : headings;

// Foto real (quando houver) é a imagem principal: topo do artigo, prévia de compartilhamento e Schema
const hero = d.foto ? { src: d.foto.src, alt: d.foto.alt } : { src: d.image, alt: d.imageAlt };
const ogImg = await getImage({ src: hero.src, width: 1200, height: 630, format: 'webp', fit: 'cover' });
const authorImg = author.avatar ? await getImage({ src: author.avatar, width: 160, height: 160, format: 'webp' }) : null;

const jsonLd = graph(
  organization(),
  website(),
  person({ ...author, image: authorImg ? abs(authorImg.src) : undefined }),
  {
    '@type': 'Article',
    '@id': abs(url) + '#article',
    headline: d.title,
    description: d.description,
    image: [abs(ogImg.src)],
    datePublished: d.pubDate.toISOString(),
    dateModified: d.updatedDate.toISOString(),
    inLanguage: SITE.locale,
    author: { '@id': personId(author.slug) },
    publisher: { '@id': ORG_ID },
    isPartOf: { '@id': WEBSITE_ID },
    mainEntityOfPage: abs(url),
    articleSection: cat.name,
    keywords: [d.keyword, ...d.tags].join(', '),
    ...(wordCount ? { wordCount } : {}),
    ...(d.sources.length ? { citation: d.sources.map((s) => s.url) } : {}),
  },
  breadcrumbList(crumbs),
  ...(d.faq?.length ? [faqPage(d.faq)] : []),
);
---
<BaseLayout
  title={d.title}
  description={d.description}
  image={hero.src}
  imageAlt={hero.alt}
  type="article"
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate}
  section={cat.name}
  tags={d.tags}
  jsonLd={jsonLd}
>
  <div class:list={['container', { 'container--reading': !ADS.enabled }]}>
    <Breadcrumbs items={crumbs} />
    <div class:list={['article-layout', { 'article-layout--sidebar': ADS.enabled }]}>
      <article>
        <header class="article-header">
          <h1>{d.title}</h1>
          <p class="article-meta">
            <span class="byline">
              {author.avatar && (
                <Image src={author.avatar} alt="" width={28} height={28} densities={[1, 2]} class="avatar avatar--byline" loading="eager" draggable="false" />
              )}
              Por&nbsp;<a href={`/autor/${author.slug}/`} rel="author">{author.name}</a>
            </span>
            <span>Atualizado em <time datetime={isoDate(d.updatedDate)}>{formatDate(d.updatedDate)}</time></span>
            {wordCount && <span>Leitura de {readMinutes} min</span>}
            {isoDate(d.pubDate) !== isoDate(d.updatedDate) && (
              <span>Publicado em <time datetime={isoDate(d.pubDate)}>{formatDate(d.pubDate)}</time></span>
            )}
          </p>
        </header>
        <figure class="article-cover">
          <Picture
            src={hero.src}
            alt={hero.alt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[400, 800, 1200]}
            sizes="(min-width: 1160px) 780px, 100vw"
            width={1200}
            height={d.foto ? 675 : 630}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          {d.foto ? (
            d.foto.fonte === 'IA' ? (
              <figcaption>Imagem ilustrativa gerada por inteligência artificial ({d.foto.credito}).</figcaption>
            ) : d.foto.creditoUrl ? (
              <figcaption>
                Foto: <a href={d.foto.creditoUrl} rel="nofollow noopener" target="_blank">{d.foto.credito}</a> / {d.foto.fonte}
              </figcaption>
            ) : (
              <figcaption>Foto: {d.foto.credito} / {d.foto.fonte}</figcaption>
            )
          ) : d.imageCredit && (
            <figcaption>
              Foto: <a href={d.imageCredit.url} rel="nofollow noopener">{d.imageCredit.name}</a> / {d.imageCredit.source}
            </figcaption>
          )}
        </figure>
        <aside class="quick-summary" aria-labelledby="resumo-rapido">
          <p class="quick-summary__title" id="resumo-rapido">Resumo rápido</p>
          <ul>
            {d.resumo.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
        <Toc headings={tocHeadings} />
        <div class="prose">
          <slot />
        </div>
        {d.sources.length > 0 && (
          <section class="sources prose" aria-labelledby="fontes">
            <h2 id="fontes">Fontes consultadas</h2>
            <ul>
              {d.sources.map((s) => (
                <li><a href={s.url} rel="noopener">{s.title}</a></li>
              ))}
            </ul>
          </section>
        )}
        <div class="share" aria-label="Compartilhar este artigo">
          <span class="share__label">Achou útil? Compartilhe:</span>
          <a class="share__btn share__btn--wa" href={`https://wa.me/?text=${shareText}`} target="_blank" rel="noopener nofollow">WhatsApp</a>
          <a class="share__btn share__btn--fb" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener nofollow">Facebook</a>
        </div>
        <AuthorBox {...author} />
        {related.length > 0 && (
          <section class="related" aria-labelledby="relacionados">
            <h2 id="relacionados">Leia também</h2>
            <div class="grid">
              {related.map((r) => <ArticleCard article={r} />)}
            </div>
          </section>
        )}
      </article>
      {ADS.enabled && (
        <aside class="sidebar" aria-label="Barra lateral">
          <div class="sidebar__sticky">
            <AdSlot variant="sidebar" />
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
