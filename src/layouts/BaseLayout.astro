---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdsInit from '../components/AdsInit.astro';
import Analytics from '../components/Analytics.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { ANALYTICS } from '../config';
import type { Props as HeadProps } from '../components/BaseHead.astro';

export type Props = HeadProps;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <Analytics />
    <BaseHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    {ANALYTICS.gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${ANALYTICS.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    )}
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {/*
      Espaço reservado para o banner de consentimento (CMP).
      Ao ativar anúncios, use uma CMP certificada pelo Google (ex.: a "Mensagens
      de privacidade e consentimento" do próprio AdSense, que injeta o banner
      sozinha) ou monte aqui o componente da CMP escolhida.
    */}
    <div id="cmp-root"></div>
    <CookieBanner />
    <AdsInit />
  </body>
</html>
