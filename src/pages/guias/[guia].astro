---
// Guias de leitura: as etapas de uma trilha, em ordem, com links para cada artigo
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Picture } from 'astro:assets';
import { TRILHAS } from '../../data/trilhas.mjs';
import { getArticles, articleSlug, articleUrl } from '../../lib/content';
import { graph, organization, website, breadcrumbList, abs } from '../../lib/schema';

export async function getStaticPaths() {
  return TRILHAS.map((t) => ({ params: { guia: t.slug }, props: { trilha: t } }));
}

const { trilha } = Astro.props;
const artigos = await getArticles();
const etapas = trilha.etapas
  .map((e) => ({ ...e, artigo: artigos.find((a) => articleSlug(a) === e.slug) }))
  .filter((e) => e.artigo);
const url = `/guias/${trilha.slug}/`;
const crumbs = [
  { name: 'Início', href: '/' },
  { name: trilha.titulo, href: url },
];
const jsonLd = graph(organization(), website(), breadcrumbList(crumbs), {
  '@type': 'ItemList',
  name: trilha.titulo,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: etapas.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.artigo!.data.title, url: abs(articleUrl(e.artigo!)) })),
});
---
<BaseLayout title={trilha.titulo} description={trilha.descricao} jsonLd={jsonLd}>
  <div class="container container--reading">
    <Breadcrumbs items={crumbs} />
    <header class="article-header">
      <h1>{trilha.titulo}</h1>
    </header>
    <div class="prose">
      {trilha.intro.map((p) => <p>{p}</p>)}
    </div>
    <ol class="trilha-etapas">
      {etapas.map((e, i) => (
        <li class="trilha-etapa">
          <a class="trilha-etapa__media" href={articleUrl(e.artigo!)} tabindex="-1" aria-hidden="true">
            <Picture
              src={e.artigo!.data.foto?.src ?? e.artigo!.data.image}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[240, 400]}
              sizes="160px"
              width={400}
              height={225}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
          <div>
            <p class="trilha-etapa__num">Etapa {i + 1} · {e.rotulo}</p>
            <h2 class="trilha-etapa__titulo"><a href={articleUrl(e.artigo!)}>{e.artigo!.data.title}</a></h2>
            <p class="trilha-etapa__desc">{e.artigo!.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
