---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, CATEGORIES } from '../config';
import { getArticles } from '../lib/content';
import { graph, organization, website } from '../lib/schema';

const articles = await getArticles();
const sections = CATEGORIES.map((c) => ({
  ...c,
  items: articles.filter((a) => a.data.category === c.slug).slice(0, 4),
})).filter((s) => s.items.length > 0);
---
<BaseLayout
  title={`${SITE.name}: documentos, IPVA, seguro, multas e manutenção`}
  rawTitle
  description={SITE.description}
  jsonLd={graph(organization(), website())}
>
  <section class="hero">
    <div class="container">
      <h1>Documentos, IPVA, multas, seguro e manutenção do carro explicados com base na lei</h1>
      <p>{SITE.description}</p>
      <form class="search-form" action="/busca/" method="get" role="search">
        <label class="visually-hidden" for="q-home">Buscar no site</label>
        <input id="q-home" name="q" type="search" placeholder="Ex.: transferência, IPVA atrasado, franquia" />
        <button class="btn" type="submit">Buscar</button>
      </form>
    </div>
  </section>

  <section class="section container" aria-labelledby="categorias">
    <h2 id="categorias">Escolha o assunto</h2>
    <ul class="cat-list">
      {CATEGORIES.map((c) => (
        <li><a href={`/${c.slug}/`}><strong>{c.name}</strong><span>{c.description}</span></a></li>
      ))}
    </ul>
  </section>

  {
    sections.map((s, i) => (
      <section class="section container" aria-labelledby={`sec-${s.slug}`}>
        <div class="section__head">
          <h2 id={`sec-${s.slug}`}>{s.name}</h2>
          <a href={`/${s.slug}/`}>Todos os guias de {s.name}</a>
        </div>
        <div class="grid">
          {s.items.map((a, j) => <ArticleCard article={a} eager={i === 0 && j === 0} />)}
        </div>
      </section>
    ))
  }
</BaseLayout>
