---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, CATEGORIES } from '../config';
import { getArticles } from '../lib/content';
import { graph, organization, website } from '../lib/schema';

const articles = await getArticles();
const latest = articles.slice(0, 9);
---
<BaseLayout
  title={`${SITE.name}: documentação, IPVA, seguro e manutenção do carro`}
  rawTitle
  description={SITE.description}
  jsonLd={graph(organization(), website())}
>
  <section class="hero">
    <div class="container">
      <h1>Dúvidas sobre o seu carro, respondidas com base na lei</h1>
      <p>{SITE.description}</p>
      <form class="search-form" action="/busca/" method="get" role="search">
        <label class="visually-hidden" for="q-home">Buscar no site</label>
        <input id="q-home" name="q" type="search" placeholder="Ex.: transferência, IPVA atrasado, franquia" />
        <button class="btn" type="submit">Buscar</button>
      </form>
    </div>
  </section>

  <section class="section container" aria-labelledby="categorias">
    <h2 id="categorias">Categorias</h2>
    <ul class="cat-list">
      {CATEGORIES.map((c) => (
        <li><a href={`/${c.slug}/`}><strong>{c.name}</strong><span>{c.description}</span></a></li>
      ))}
    </ul>
  </section>

  {
    latest.length > 0 && (
      <section class="section container" aria-labelledby="recentes">
        <h2 id="recentes">Atualizados recentemente</h2>
        <div class="grid">
          {latest.map((a) => <ArticleCard article={a} />)}
        </div>
      </section>
    )
  }
</BaseLayout>
